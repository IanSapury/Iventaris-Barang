# ============================================================
# .env.example
# Template file environment untuk Backend
# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# Konfigurasi Server
PORT=3000
NODE_ENV=development

# Konfigurasi Database MySQL (Cloud: Aiven, TiDB, PlanetScale, dll)
DB_HOST=your-db-host.com
DB_PORT=3306
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=db_inventaris

# JWT Secret untuk autentikasi
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin (Frontend URL - Vercel)
# Development: http://localhost:5173 atau http://127.0.0.1:5500
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
