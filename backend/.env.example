# ============================================================
# .env.example
# Template file environment untuk Backend
# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# Konfigurasi Server
PORT=3000
NODE_ENV=development

# ============================================================
# Konfigurasi Database MySQL
# ============================================================
# Railway akan otomatis inject variabel ini dari MySQL plugin:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
#
# Untuk development lokal, gunakan variabel custom:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=db_inventaris

# JWT Secret untuk autentikasi
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin (Frontend URL) - Opsional untuk Railway (same origin)
# Development: http://localhost:5173 atau http://127.0.0.1:5500
# Production Railway: tidak perlu (same origin)
FRONTEND_URL=http://localhost:8000
